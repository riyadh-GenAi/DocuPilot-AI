# Copy this file to .env and replace local-only placeholders before running.
# Never commit .env or put provider credentials in frontend settings.

APP_NAME=DocuPilot AI
DEBUG=false
PACKAGE=standard

# Configure one backend chat provider.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
MODEL_NAME=gpt-4o-mini

# Local embeddings are enabled by default.
EMBEDDING_BACKEND=local
EMBEDDING_FALLBACK_LOCAL=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384
LOCAL_MODEL_CACHE_DIR=
HF_HOME=./.cache/huggingface

# For local API execution, update the placeholder credentials to match PostgreSQL.
DATABASE_URL=postgresql+psycopg2://docupilot:CHANGE_ME_LOCAL_ONLY@localhost:5432/docupilot_ai
UPLOAD_DIR=./data/uploads

# Compose uses these to configure the PostgreSQL container and API connection.
POSTGRES_DB=docupilot_ai
POSTGRES_USER=docupilot
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=20
RETRIEVAL_TOP_K=5

# Used only when running Streamlit outside Compose; Compose sets its API URL.
API_URL=http://localhost:8000/api
